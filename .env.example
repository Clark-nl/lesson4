# Copy to .env and fill in as needed. Environment variables always
# override values from a YAML config file (see config/kronos.example.yaml).
# NEVER commit your real .env file.

# Master safe/live switch. Must be the literal string "true" to enable
# real order submission; anything else (including unset) stays in
# dry-run/paper mode.
KRONOS_LIVE_TRADING=false

# Must stay true whenever KRONOS_LIVE_TRADING=true.
KRONOS_REQUIRE_APPROVAL=true

# Risk limits (EUR)
KRONOS_MAX_ORDER_VALUE_EUR=500
KRONOS_MAX_DAILY_LOSS_EUR=250
KRONOS_MAX_POSITION_VALUE_EUR=2000

# Interactive Brokers TWS/Gateway connection
KRONOS_IBKR_HOST=127.0.0.1
KRONOS_IBKR_PORT=7497
KRONOS_IBKR_CLIENT_ID=7
KRONOS_IBKR_ACCOUNT=

# Optional: enables the LLM-based "news vibe" component of VibeStrategy.
ANTHROPIC_API_KEY=
KRONOS_USE_LLM_VIBE=false
