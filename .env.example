# Shopify Partner Dashboard > App > Client credentials 에서 확인
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# 앱에 필요한 권한 범위 (comma-separated)
SCOPES=read_products,read_orders

# 이 앱이 배포된 공개 URL (OAuth 콜백에 사용). 로컬 개발 시 ngrok/cloudflared 등의 터널 URL을 사용하세요.
HOST=http://localhost:3000

# 서버 포트
PORT=3000

# 세션 서명용 쿠키 시크릿 (임의의 랜덤 문자열로 교체)
COOKIE_SECRET=change_this_to_a_random_secret
