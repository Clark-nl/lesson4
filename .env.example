# Zentrada login
ZENTRADA_BASE_URL=https://www.zentrada.com
ZENTRADA_LOGIN_PATH=/login
ZENTRADA_RECOMMENDATIONS_PATH=/my/recommendations
ZENTRADA_USERNAME=
ZENTRADA_PASSWORD=

# Adjust to match the real login form field names (see README)
LOGIN_FORM_USERNAME_FIELD=username
LOGIN_FORM_PASSWORD_FIELD=password

# Adjust to match the real recommendations page markup (see README)
SELECTOR_PRODUCT_CARD=.product-card
SELECTOR_PRODUCT_NAME=.product-name
SELECTOR_PRODUCT_PRICE=.product-price
SELECTOR_PRODUCT_LINK=a.product-link
SELECTOR_PRODUCT_SKU=

# Comma-separated keywords; leave empty to alert on every recommended item
WATCH_KEYWORDS=

# Gmail (use an App Password, not your normal password)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
