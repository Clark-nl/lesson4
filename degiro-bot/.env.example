# Copy this file to .env and fill in real values. Never commit .env.
DEGIRO_USERNAME=
DEGIRO_PASSWORD=
DEGIRO_INT_ACCOUNT=
# DeGiro sometimes requires a TOTP code for 2FA-enabled accounts.
DEGIRO_TOTP_SECRET=

# Required safety confirmation before the bot will place real orders.
# Set to "true" only once you understand this bot trades with real money.
I_UNDERSTAND_THE_RISK=false
