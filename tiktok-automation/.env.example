# Copy this file to .env and fill in real values. Never commit .env.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/callback

# Filled in automatically by oauth_setup.py after the one-time login;
# upload_video.py reads these to refresh access tokens without any
# further manual login.
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
